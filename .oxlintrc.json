{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "react", "jsx-a11y", "nextjs", "typescript", "vitest", "unicorn", "oxc"],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "rules": {
    "react/react-in-jsx-scope": "off"
  },
  "options": {
    "typeAware": false,
    "typeCheck": false
  },
  "ignorePatterns": [".next/**", "out/**", "build/**", "next-env.d.ts"],
  "env": {
    "builtin": true
  }
}
